{
	"name": "Monaco",
	"version": "2.8.6",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"author": [
		"'''Universal Omega'''",
		"Inez Korczyński",
		"Christian Williams",
		"Daniel Friesen",
		"James Haley",
		"Roger Meier",
		"WikiForMen"
	],
	"url": "https://www.mediawiki.org/wiki/Skin:Monaco",
	"descriptionmsg": "monaco-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "skin",
	"ValidSkinNames": {
		"monaco": {
			"displayname": "Monaco",
			"class": "SkinMonaco",
			"args": [ {
				"name": "monaco",
				"template": "MonacoTemplate",
				"styles": [
					"mediawiki.skinning.content",
					"mediawiki.skinning.content.externallinks",
					"skins.monaco"
				],
				"scripts": [
					"skins.monaco.scripts"
				]
			} ]
		}
	},
	"attributes": {
		"Theme": {
			"Modules": {
				"monaco": [
					"beach",
					"brick",
					"carbon",
					"forest",
					"gaming",
					"jade",
					"moonlight",
					"obsession",
					"ruby",
					"sapphire",
					"sky",
					"slate",
					"smoke",
					"spring"
				]
			}
		}
	},
	"MessagesDirs": {
		"Monaco": [
			"i18n"
		]
	},
	"ConfigRegistry": {
		"monaco": "GlobalVarConfig::newInstance"
	},
	"ResourceModules": {
		"skins.monaco": {
			"class": "ResourceLoaderSkinModule",
			"targets": [
				"desktop",
				"mobile"
			],
			"position": "top",
			"styles": {
				"style/css/print.css": {
					"media": "print"
				},
				"style/css/monobook_modified.css": {
					"media": "screen"
				},
				"style/css/reset_modified.css": {
					"media": "screen"
				},
				"style/css/root.css": {
					"media": "screen"
				},
				"style/css/header.css": {
					"media": "screen"
				},
				"style/css/article.css": {
					"media": "screen"
				},
				"style/css/widgets.css": {
					"media": "screen"
				},
				"style/css/footer.css": {
					"media": "screen"
				},
				"style/css/ny.css": {
					"media": "screen"
				},
				"style/css/buttons.css": {
					"media": "screen"
				},
				"style/css/sprite.css": {
					"media": "screen"
				},
				"style/css/modal.css": {
					"media": "screen"
				},
				"style/css/star_rating.css": {
					"media": "screen"
				}
			}
		},
		"skins.monaco.scripts": {
			"scripts": "style/js/monaco.js"
		},
		"skins.monaco.widget": {
			"position" : "bottom",
			"scripts": "style/js/monacoWidget.js",
			"styles": {
				"style/css/monacoWidget.css": {
					"media": "screen"
				}
			}
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Monaco"
	},
	"config": {
		"MonacoAllowUseTheme": {
			"value": true
		},
		"MonacoDefaultTheme": {
			"value": "sapphire"
		},
		"MonacoSkipThemes": {
			"value": [ "theme1", "theme2" ]
		},
		"MonacoDynamicCreateOverride": {
			"value": false
		},
		"MonacoUseMoreButton": {
			"value": true
		},
		"MonacoUseSitenoticeIsland": {
			"value": false
		},
		"MonacoUseMasthead": {
			"value": true
		},
		"MonacoCompactSpecialPages": {
			"value": false
		},
		"MonacoBiggestCategoriesBlacklist": {
			"value": []
		},
		"MonacoEnablePaypal": {
			"value": false
		},
		"MonacoPaypalID": {
			"value": ""
		},
		"MonacoEnablePatreon": {
			"value": false
		},
		"MonacoPatreonURL": {
			"value": ""
		},
		"MonacoSearchDefaultFulltext": {
			"value": true
		},
		"MonacoSpecialPagesRequiredLogin": {
			"value": []
		}
	},
	"AutoloadClasses": {
		"SkinMonaco": "includes/SkinMonaco.php",
		"MonacoHooks": "includes/MonacoHooks.php",
		"MonacoSidebar": "includes/MonacoSidebar.php",
		"MonacoTemplate": "includes/MonacoTemplate.php"
	},
	"HookHandlers": {
		"main": {
			"class": "MonacoHooks",
			"services": [
				"MainConfig",
				"UserOptionsLookup"
			]
		}
	},
	"Hooks": {
		"GetPreferences": "main",
		"MessageCacheReplace": [
			"MonacoSidebar::invalidateCache"
		],
		"OutputPageBodyAttributes": "main"
	},
	"manifest_version": 2
}
